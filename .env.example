EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://192.168.1.7:5000/api

# Google OAuth — Web + iOS client IDs from Google Cloud Console (must match
# HunterX-Backend's GOOGLE_CLIENT_ID_WEB/_IOS). Android needs no client ID
# here — it's matched automatically via package name + SHA-1 fingerprint.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

PORT=8081
